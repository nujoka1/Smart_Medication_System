def _run_pill_ai_observation(image_path):
    """
    Try to run the existing pill detector if available.
    If no detector is available, return MODEL_UNAVAILABLE.
    This function is intentionally defensive so evidence capture does not fail
    just because AI model loading fails.
    """
    result = {
        "available": False,
        "detected_class": None,
        "confidence": None,
        "bbox": None,
        "error": None
    }

    try:
        detector = None

        # Try common project detector modules/classes
        try:
            from src.ai.pill_detector import PillDetector
            detector = PillDetector()
        except Exception:
            try:
                from src.ai.detector import PillDetector
                detector = PillDetector()
            except Exception:
                detector = None

        if detector is None:
            result["error"] = "MODEL_UNAVAILABLE"
            return result

        prediction = None

        for method_name in ["predict", "detect", "classify"]:
            if hasattr(detector, method_name):
                prediction = getattr(detector, method_name)(str(image_path))
                break

        if prediction is None:
            result["error"] = "NO_SUPPORTED_DETECTOR_METHOD"
            return result

        # Normalize dictionary-style outputs
        if isinstance(prediction, dict):
            result["available"] = True
            result["detected_class"] = (
                prediction.get("detected_class")
                or prediction.get("class")
                or prediction.get("label")
                or prediction.get("name")
            )
            result["confidence"] = (
                prediction.get("confidence")
                or prediction.get("conf")
                or prediction.get("score")
            )
            result["bbox"] = (
                prediction.get("bbox")
                or prediction.get("box")
                or prediction.get("xyxy")
            )
            return result

        # Normalize tuple/list outputs: (class, confidence)
        if isinstance(prediction, (list, tuple)) and len(prediction) >= 2:
            result["available"] = True
            result["detected_class"] = prediction[0]
            result["confidence"] = prediction[1]
            if len(prediction) >= 3:
                result["bbox"] = prediction[2]
            return result

        # Fallback string result
        if isinstance(prediction, str):
            result["available"] = True
            result["detected_class"] = prediction
            result["confidence"] = None
            return result

        result["error"] = "UNRECOGNIZED_MODEL_OUTPUT"
        return result

    except Exception as e:
        result["error"] = str(e)
        return result


def _decide_evidence_outcome(expected_ai_class, model_result, ir_target_count, ir_actual_count):
    """
    Safety-first decision logic.
    Custom medications are not AI-verified even if the model predicts something.
    """
    try:
        ir_target_count = int(ir_target_count or 0)
        ir_actual_count = int(ir_actual_count or 0)
    except Exception:
        ir_target_count = 0
        ir_actual_count = 0

    count_ok = True
    if ir_target_count > 0:
        count_ok = (ir_actual_count == ir_target_count)

    if not count_ok:
        return "COUNT_ERROR"

    expected_ai_class = expected_ai_class or "custom"

    if expected_ai_class == "custom":
        return "CUSTOM_COUNT_CAMERA"

    if not model_result.get("available"):
        return "AI_UNCERTAIN_REVIEW"

    detected = model_result.get("detected_class")
    confidence = model_result.get("confidence")

    try:
        confidence_value = float(confidence)
    except Exception:
        confidence_value = 0.0

    if detected == expected_ai_class and confidence_value >= 0.75:
        return "VERIFIED_AI"

    if detected and detected != expected_ai_class:
        return "AI_MISMATCH_WARNING"

    return "AI_UNCERTAIN_REVIEW"


def _draw_annotated_evidence(raw_path, annotated_path, metadata):
    """
    Draw expected drug, AI observation, confidence, decision, and bbox if available.
    If the model has no bbox, we do NOT fake a bounding box.
    """
    from PIL import Image, ImageDraw, ImageFont

    img = Image.open(raw_path).convert("RGB")
    draw = ImageDraw.Draw(img)

    w, h = img.size

    try:
        font_big = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 24)
        font_small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 18)
    except Exception:
        font_big = ImageFont.load_default()
        font_small = ImageFont.load_default()

    expected_name = metadata.get("expected_name") or "Unknown"
    expected_ai_class = metadata.get("expected_ai_class") or "custom"
    model = metadata.get("model_result") or {}
    detected = model.get("detected_class") or "N/A"
    confidence = model.get("confidence")
    decision = metadata.get("decision") or "UNKNOWN"
    verification_mode = metadata.get("verification_mode") or "unknown"

    if confidence is None:
        conf_text = "N/A"
    else:
        try:
            conf_text = f"{float(confidence) * 100:.1f}%"
        except Exception:
            conf_text = str(confidence)

    # Header background
    draw.rectangle([0, 0, w, 92], fill=(8, 8, 22))

    draw.text((12, 8), f"Expected: {expected_name}", fill=(255, 255, 255), font=font_big)
    draw.text((12, 42), f"AI class: {expected_ai_class}", fill=(180, 160, 255), font=font_small)
    draw.text((12, 65), f"Mode: {verification_mode}", fill=(120, 255, 180), font=font_small)

    # Draw bbox only if model returned one
    bbox = model.get("bbox")
    if bbox and isinstance(bbox, (list, tuple)) and len(bbox) >= 4:
        try:
            x1, y1, x2, y2 = [float(v) for v in bbox[:4]]

            # If bbox looks normalized, scale it
            if 0 <= x1 <= 1 and 0 <= x2 <= 1 and 0 <= y1 <= 1 and 0 <= y2 <= 1:
                x1, x2 = x1 * w, x2 * w
                y1, y2 = y1 * h, y2 * h

            draw.rectangle([x1, y1, x2, y2], outline=(0, 255, 120), width=4)
            draw.rectangle([x1, max(0, y1 - 30), min(w, x1 + 360), y1], fill=(8, 8, 22))
            draw.text((x1 + 6, max(0, y1 - 28)), f"{detected} {conf_text}", fill=(0, 255, 120), font=font_small)
        except Exception:
            pass

    # Footer background
    footer_y = h - 76
    draw.rectangle([0, footer_y, w, h], fill=(8, 8, 22))

    if decision == "VERIFIED_AI":
        color = (0, 255, 120)
    elif decision in ["AI_MISMATCH_WARNING", "COUNT_ERROR"]:
        color = (255, 80, 80)
    else:
        color = (255, 190, 60)

    draw.text((12, footer_y + 8), f"AI observed: {detected} ({conf_text})", fill=(255, 255, 255), font=font_small)
    draw.text((12, footer_y + 36), f"Decision: {decision}", fill=color, font=font_big)

    img.save(annotated_path, quality=90)


@app.route('/api/evidence/capture', methods=['POST'])
def evidence_capture():
    """
    Capture dose evidence:
    - Turn LED GPIO12 ON
    - Capture raw image
    - Turn LED OFF
    - Run AI observation if available
    - Apply verification logic
    - Save raw.jpg, annotated.jpg, metadata.json
    """
    import uuid
    import json
    import subprocess
    import time
    from datetime import datetime

    d = request.get_json() or {}

    expected_name = d.get("expected_name") or "Medication"
    expected_ai_class = d.get("expected_ai_class") or "custom"
    verification_mode = d.get("verification_mode") or (
        "count_camera_only" if expected_ai_class == "custom" else "ai_camera_count"
    )

    patient_id = d.get("patient_id")
    schedule_id = d.get("schedule_id")
    medication_id = d.get("medication_id")
    ir_target_count = d.get("ir_target_count", 0)
    ir_actual_count = d.get("ir_actual_count", 0)

    LED_GPIO = 12
    gpio_ready = False

    evidence_id = datetime.now().strftime("%Y%m%d_%H%M%S") + "_" + uuid.uuid4().hex[:6]
    evidence_dir = Path("data/evidence") / evidence_id
    evidence_dir.mkdir(parents=True, exist_ok=True)

    raw_path = evidence_dir / "raw.jpg"
    annotated_path = evidence_dir / "annotated.jpg"
    metadata_path = evidence_dir / "metadata.json"

    try:
        import RPi.GPIO as GPIO

        GPIO.setwarnings(False)
        GPIO.setmode(GPIO.BCM)
        GPIO.setup(LED_GPIO, GPIO.OUT, initial=GPIO.LOW)
        gpio_ready = True

        started = time.time()

        # LED ON
        GPIO.output(LED_GPIO, GPIO.HIGH)
        time.sleep(0.3)

        # Capture raw image
        cmd = [
            "rpicam-still",
            "-o", str(raw_path),
            "--nopreview",
            "--timeout", "2000"
        ]

        p = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=8
        )

        # LED OFF
        GPIO.output(LED_GPIO, GPIO.LOW)

        if p.returncode != 0:
            metadata = {
                "evidence_id": evidence_id,
                "success": False,
                "error": p.stderr[-500:] if p.stderr else "Camera command failed",
                "decision": "CAMERA_ERROR",
                "created_at": datetime.now().isoformat()
            }
            metadata_path.write_text(json.dumps(metadata, indent=2))
            return jsonify(metadata), 500

        # AI observation runs even for custom medication,
        # but custom medication does NOT use AI for final approval.
        model_result = _run_pill_ai_observation(raw_path)

        decision = _decide_evidence_outcome(
            expected_ai_class,
            model_result,
            ir_target_count,
            ir_actual_count
        )

        metadata = {
            "evidence_id": evidence_id,
            "success": True,
            "created_at": datetime.now().isoformat(),
            "patient_id": patient_id,
            "schedule_id": schedule_id,
            "medication_id": medication_id,
            "expected_name": expected_name,
            "expected_ai_class": expected_ai_class,
            "verification_mode": verification_mode,
            "ir_target_count": ir_target_count,
            "ir_actual_count": ir_actual_count,
            "model_result": model_result,
            "model_used_for_decision": expected_ai_class != "custom",
            "decision": decision,
            "raw_image_path": str(raw_path),
            "annotated_image_path": str(annotated_path),
            "raw_url": f"/api/evidence/{evidence_id}/raw.jpg",
            "annotated_url": f"/api/evidence/{evidence_id}/annotated.jpg",
            "elapsed_ms": int((time.time() - started) * 1000),
            "led_gpio": "BCM GPIO12 / physical pin 32"
        }

        try:
            _draw_annotated_evidence(raw_path, annotated_path, metadata)
        except Exception as e:
            metadata["annotation_error"] = str(e)
            annotated_path.write_bytes(raw_path.read_bytes())

        metadata_path.write_text(json.dumps(metadata, indent=2))

        return jsonify(metadata)

    except Exception as e:
        metadata = {
            "evidence_id": evidence_id,
            "success": False,
            "error": str(e),
            "decision": "MODEL_ERROR",
            "created_at": datetime.now().isoformat()
        }
        metadata_path.write_text(json.dumps(metadata, indent=2))
        return jsonify(metadata), 500

    finally:
        if gpio_ready:
            try:
                GPIO.output(LED_GPIO, GPIO.LOW)
                GPIO.cleanup(LED_GPIO)
            except Exception:
                pass


@app.route('/api/evidence/latest')
def evidence_latest():
    import json

    limit = int(request.args.get("limit", 20))
    limit = max(1, min(limit, 100))

    base = Path("data/evidence")
    if not base.exists():
        return jsonify([])

    rows = []
    for meta in sorted(base.glob("*/metadata.json"), reverse=True):
        try:
            rows.append(json.loads(meta.read_text()))
        except Exception:
            pass

    return jsonify(rows[:limit])


@app.route('/api/evidence/<evidence_id>/<path:filename>')
def evidence_file(evidence_id, filename):
    allowed = {"raw.jpg", "annotated.jpg", "metadata.json"}

    if filename not in allowed:
        abort(404)

    file_path = Path("data/evidence") / evidence_id / filename

    if not file_path.exists():
        abort(404)

    return send_file(file_path)


